#include "stdlib.fc";
#include "utils/dict.utils.fc";
#include "utils/jetton_receive_effect_key.utils.fc";

;; storage variables

global int storage::shard_offset;
global slice storage::owner_address;
global cell storage::effects_dict;

() load_storage() impure {
    slice cs::storage = get_data().begin_parse();

    storage::shard_offset = cs::storage~load_uint(32);
    storage::owner_address = cs::storage~load_msg_addr();
    storage::effects_dict = cs::storage~load_dict();

    cs::storage.end_parse();
}

() save_storage() impure {
    set_data(
        begin_cell()
            .store_uint(storage::shard_offset, 32)
            .store_slice(storage::owner_address)
            .store_dict(storage::effects_dict)
            .end_cell()
    );
}

(int, slice, cell) get_storage() method_id {
    load_storage();

    return (
        storage::shard_offset,
        storage::owner_address,
        storage::effects_dict
    );
}

(slice, int) get_effect_dict(slice jetton_wallet_address_to_listen, slice jetton_sender_address_to_listen, int query_id) method_id {
    load_storage();

    slice index = build_jetton_receive_effect_key(
        jetton_wallet_address_to_listen,
        jetton_sender_address_to_listen,
        query_id
    );

    var (value, success?) = storage::effects_dict.dict_get?(jetton_receive_effect_key_len, index);

    return (
        value,
        success?
    );
}
